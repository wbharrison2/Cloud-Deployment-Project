# Application
NODE_ENV=production
PORT=3000

# Database (RDS PostgreSQL 15 Multi-AZ)
# In Kubernetes: stored in agw-secrets Secret, not here
DATABASE_URL=postgres://agw:CHANGE_ME@your-rds-endpoint.us-west-2.rds.amazonaws.com:5432/agwdb?sslmode=require

# Redis (ElastiCache 7.2, TLS)
# In Kubernetes: stored in agw-secrets Secret, not here
REDIS_URL=rediss://:CHANGE_ME@your-elasticache-endpoint.cache.amazonaws.com:6379

# Auth
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# Cookie (use __Host- prefix in production for HTTPS enforcement)
COOKIE_NAME=__Host-agw_token
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Stripe (use live keys in production)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# AWS (for CloudFront cache invalidation on /api/admin/cache/clear)
AWS_REGION=us-west-2
CLOUDFRONT_DISTRIBUTION_ID=CHANGE_ME

# CORS
CORS_ORIGIN=https://artisangemworks.com

# Local development only (docker-compose)
# DATABASE_URL=postgres://agw:devpassword@postgres:5432/agwdb
# REDIS_URL=redis://:devpassword@redis:6379
# JWT_SECRET=dev-jwt-secret-change-in-production
# COOKIE_NAME=agw_token
# COOKIE_SECURE=false
