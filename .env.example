# Artisan Gem Works - Project 4 Environment Variables
# Copy to .env and fill in values before running docker compose

# Database
DATABASE_URL=postgresql://agw:CHANGE_ME@localhost:5432/agw
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL_PRODUCTS=300
REDIS_TTL_CATEGORIES=3600
REDIS_TTL_LOCATIONS=86400

# Auth
JWT_SECRET=replace-with-64-char-hex-string
JWT_EXPIRES_IN=8h
COOKIE_SECRET=replace-with-32-char-hex-string
TOTP_ISSUER=Artisan Gem Works

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE

# AWS (production only)
AWS_REGION=us-west-2
CLOUDFRONT_DISTRIBUTION_ID=
ECR_REPO=
